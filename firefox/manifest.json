{
  "manifest_version": 3,
  "name": "Youtube Notification Expander",
  "version": "1.1",

  "description": "Replaces 9+ in the YouTube notification bell with the actual number of notifications.",

  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-notification-expander@diodescaer.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["main.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}